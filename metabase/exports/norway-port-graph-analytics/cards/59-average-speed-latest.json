        "native": "WITH filtered AS\n(\n    SELECT *\n    FROM analytics.ais_vessel_features\n    WHERE 1 = 1\n      [[AND {{window_minutes}}]]\n),\nlatest AS\n(\n    SELECT max(window_end) AS latest_window_end\n    FROM filtered\n)\nSELECT round(avg(f.avg_speed), 2) AS avg_speed\nFROM filtered AS f\nWHERE f.window_end = (SELECT latest_window_end FROM latest)\n  AND f.avg_speed IS NOT NULL;",
