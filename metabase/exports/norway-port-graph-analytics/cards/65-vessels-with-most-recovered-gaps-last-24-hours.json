{
  "cache_ttl": null,
  "dataset_query": {
    "database": 2,
    "lib/type": "mbql/query",
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT\n    mmsi,\n    argMax(name, gap_ended_at) AS name,\n    argMax(ship_category, gap_ended_at) AS ship_category,\n    count() AS recovered_gaps,\n    round(avg(gap_duration_seconds) / 60, 1) AS avg_gap_minutes,\n    round(max(gap_duration_seconds) / 60, 1) AS max_gap_minutes\nFROM analytics.ais_vessel_gap_events\nWHERE event_type = 'AIS_GAP_ENDED'\n  AND gap_ended_at >= now('UTC') - INTERVAL 24 HOUR\n  AND gap_duration_seconds IS NOT NULL\nGROUP BY mmsi\nORDER BY recovered_gaps DESC, max_gap_minutes DESC\nLIMIT 10;"
      }
    ]
  },
