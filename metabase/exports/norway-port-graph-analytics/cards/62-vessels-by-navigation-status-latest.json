    "lib/type": "mbql/query",
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "WITH filtered AS\n(\n    SELECT *\n    FROM analytics.ais_vessel_features\n    WHERE 1 = 1\n      [[AND {{window_minutes}}]]\n),\nlatest AS\n(\n    SELECT max(window_end) AS latest_window_end\n    FROM filtered\n)\nSELECT\n    coalesce(last_navigation_status_name, 'Unknown') AS navigation_status,\n    uniqExact(mmsi) AS vessels\nFROM filtered\nWHERE window_end = (SELECT latest_window_end FROM latest)\nGROUP BY navigation_status\nORDER BY vessels DESC;",
