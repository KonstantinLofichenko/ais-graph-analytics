  "dataset_query": {
    "database": 2,
    "lib/type": "mbql/query",
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "WITH filtered AS\n(\n    SELECT *\n    FROM analytics.ais_vessel_features\n    WHERE 1 = 1\n      [[AND {{window_minutes}}]]\n),\nlatest AS\n(\n    SELECT max(window_end) AS latest_window_end\n    FROM filtered\n)\nSELECT\n    name,\n    mmsi,\n    ship_category,\n    last_navigation_status_name AS navigation_status,\n    position_count,\n    round(avg_speed, 2) AS avg_speed,\n    round(min_speed, 2) AS min_speed,\n    round(max_speed, 2) AS max_speed,\n    window_start,\n    window_end\nFROM filtered\nWHERE window_end = (SELECT latest_window_end FROM latest)\nORDER BY max_speed DESC NULLS LAST\nLIMIT 100;",
