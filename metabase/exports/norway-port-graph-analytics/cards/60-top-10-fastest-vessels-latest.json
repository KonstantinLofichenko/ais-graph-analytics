    "lib/type": "mbql/query",
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "WITH filtered AS\n(\n    SELECT *\n    FROM analytics.ais_vessel_features\n    WHERE 1 = 1\n      [[AND {{window_minutes}}]]\n),\nlatest AS\n(\n    SELECT max(window_end) AS latest_window_end\n    FROM filtered\n)\nSELECT\n    mmsi,\n    name,\n    ship_category,\n\tlast_navigation_status_name,\n    round(avg_speed, 2) AS avg_speed,\n    round(max_speed, 2) AS max_speed\nFROM filtered\nWHERE window_end = (SELECT latest_window_end FROM latest)\n  AND max_speed IS NOT NULL\nORDER BY max_speed DESC\nLIMIT 10;",
