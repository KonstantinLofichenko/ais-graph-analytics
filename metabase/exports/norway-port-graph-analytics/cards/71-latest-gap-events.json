{
  "cache_ttl": null,
  "dataset_query": {
    "database": 2,
    "lib/type": "mbql/query",
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT\n    multiIf(\n        event_type = 'AIS_GAP_DETECTED', 'Detected',\n        event_type = 'AIS_GAP_ENDED', 'Recovered',\n        event_type\n    ) AS event_type,\n    name,\n    mmsi,\n    ship_category,\n    coalesce(\n        resumed_navigation_status_name,\n        navigation_status_name\n    ) AS navigation_status,\n    gap_detected_at,\n    gap_ended_at,\n    round(gap_duration_seconds / 60, 1) AS gap_minutes,\n    coalesce(gap_ended_at, gap_detected_at) AS event_time\nFROM analytics.ais_vessel_gap_events\nWHERE coalesce(gap_ended_at, gap_detected_at)\n      >= now('UTC') - INTERVAL 24 HOUR\nORDER BY event_time DESC\nLIMIT 100;"
      }
    ]
  },
  "description": null,
  "display": "table",
  "id": 71,
  "name": "Latest Gap Events",
