# Port-visit batch connections (host defaults; passwords reused above)
CLICKHOUSE_URL=http://localhost:8123
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
BW_HISTORIC_BASE_URL=https://historic.ais.barentswatch.no
BW_HISTORIC_SCOPE=ais
BW_HISTORIC_WINDOW_HOURS=24
BW_HISTORIC_BATCH_SIZE=5000
BW_HISTORIC_REQUEST_TIMEOUT_SECONDS=60
