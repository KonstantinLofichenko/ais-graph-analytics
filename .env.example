# BarentsWatch AIS credentials
BW_AIS_CLIENT_ID=your_client_id
BW_AIS_CLIENT_SECRET=your_client_secret

# BarentsWatch endpoints
BW_TOKEN_URL=https://id.barentswatch.no/connect/token
BW_AIS_URL=https://live.ais.barentswatch.no/v1/combined

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ais.positions

# Neo4j
NEO4J_PASSWORD=your_neo4j_password

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=ais
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password

# Airflow
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=your_airflow_password

# Port-visit batch connections (host defaults; passwords reused above)
CLICKHOUSE_URL=http://localhost:8123
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
BW_HISTORIC_BASE_URL=https://historic.ais.barentswatch.no
BW_HISTORIC_SCOPE=ais
BW_HISTORIC_WINDOW_HOURS=24
BW_HISTORIC_BATCH_SIZE=5000
BW_HISTORIC_REQUEST_TIMEOUT_SECONDS=60
BW_HISTORIC_POLYGON_JSON={"type":"Polygon","coordinates":[[[5.20,60.32],[5.45,60.32],[5.45,60.48],[5.20,60.48],[5.20,60.32]]]}

# Test producer
AIS_MESSAGE_LIMIT=

# Port-visit batch processing configuration
PORT_VISITS_WINDOW_HOURS=24
PORT_VISITS_MAX_ROWS=5000000

# WPI port reference
PORTS_SOURCE_URL=https://gis.unocha.org/server/rest/services/Hosted/global_world_seaport_index_202511/FeatureServer/0/query
PORTS_MIN_LAT=57
PORTS_MAX_LAT=72
PORTS_MIN_LON=4
PORTS_MAX_LON=32
PORTS_COUNTRY=NO

# Airbyte
# Email: your_airbyte_email
# Password: your_airbyte_password
# Client-Id: your_airbyte_client_id
# Client-Secret: your_airbyte_client_secret
AIRBYTE_API_URL=http://localhost:8000
AIRBYTE_API_KEY=your_airbyte_api_key
AIRBYTE_ACCESS_TOKEN=your_airbyte_access_token

# Rest Countries API Key
REST_COUNTRIES_API_KEY=your_rest_countries_api_key

# HAIS host directory for historical files ingestion
HAIS_HOST_DIR=./data/hais

# Metabase
METABASE_URL=http://localhost:3000
METABASE_USER=your_airbyte_email
METABASE_PASSWORD=your_metabase_password
METABASE_API_KEY=your_metabase_api_key

# Daily vessel AI enrichment (required when enabling the scheduled DAG)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6-luna
AI_ENRICHMENT_LIMIT=100
